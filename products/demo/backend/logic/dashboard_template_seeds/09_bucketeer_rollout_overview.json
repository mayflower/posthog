{
    "template_name": "Bucketeer rollout and experiment overview",
    "dashboard_description": "Flag exposure and goal conversion from Bucketeer. These are Bucketeer's own evaluation and goal events, so the assignment was made by Bucketeer, not by PostHog. Connect the Bucketeer data warehouse source to join this against flag, experiment and goal configuration.",
    "dashboard_filters": {},
    "tags": [],
    "tiles": [
        {
            "name": "Evaluations over time",
            "type": "INSIGHT",
            "color": null,
            "description": "Every flag evaluation Bucketeer exported. Bucketeer performed the assignment; PostHog is recording it.",
            "query": {
                "kind": "InsightVizNode",
                "source": {
                    "kind": "TrendsQuery",
                    "series": [
                        {
                            "id": "bucketeer_feature_evaluated",
                            "kind": "EventsNode",
                            "math": "total",
                            "name": "bucketeer_feature_evaluated",
                            "event": "bucketeer_feature_evaluated"
                        }
                    ],
                    "interval": "day",
                    "dateRange": {
                        "date_from": "-14d",
                        "explicitDate": false
                    },
                    "properties": [],
                    "trendsFilter": {
                        "display": "ActionsLineGraph",
                        "showLegend": true,
                        "aggregationAxisFormat": "numeric"
                    },
                    "filterTestAccounts": false,
                    "breakdownFilter": {
                        "breakdown_type": "event"
                    }
                }
            },
            "layouts": {
                "sm": {
                    "h": 5,
                    "w": 6,
                    "x": 0,
                    "y": 0,
                    "minH": 5,
                    "minW": 3
                },
                "xs": {
                    "h": 5,
                    "w": 1,
                    "x": 0,
                    "y": 0,
                    "minH": 5,
                    "minW": 3
                }
            }
        },
